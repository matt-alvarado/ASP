VROCP0OXY4 <=> VROCP0OXY4	; 1.0;	1.	; 1.5395e-07	; 85.0	; ! C*298 = 1
VELHOM <=> VELHOM	; 1.0;	1.	; 9.4796e-13	; 160.0	; ! C*298 = 1e-05
VROCN2OXY2 <=> VROCN2OXY2	; 1.0;	1.	; 1.1268e-09	; 93.0	; ! C*298 = 0.01
VROCP0OXY2 <=> VROCP0OXY2	; 1.0;	1.	; 1.2848e-07	; 85.0	; ! C*298 = 1
VROCP1OXY3 <=> VROCP1OXY3	; 1.0;	1.	; 1.5230e-06	; 81.0	; ! C*298 = 10
VROCP3ALK <=> VROCP3ALK	; 1.0;	1.	; 1.0167e-04	; 73.0	; ! C*298 = 1e+03
VROCP2ALK <=> VROCP2ALK	; 1.0;	1.	; 9.0004e-06	; 77.0	; ! C*298 = 100
VROCP1ALK <=> VROCP1ALK	; 1.0;	1.	; 8.0921e-07	; 81.0	; ! C*298 = 10
VROCP2OXY2 <=> VROCP2OXY2	; 1.0;	1.	; 1.5218e-05	; 77.0	; ! C*298 = 100
VROCP1OXY1 <=> VROCP1OXY1	; 1.0;	1.	; 1.1390e-06	; 81.0	; ! C*298 = 10
VROCN1OXY1 <=> VROCN1OXY1	; 1.0;	1.	; 1.0074e-08	; 89.0	; ! C*298 = 0.1
VROCN2OXY4 <=> VROCN2OXY4	; 1.0;	1.	; 1.3699e-09	; 93.0	; ! C*298 = 0.01
VROCN1OXY3 <=> VROCN1OXY3	; 1.0;	1.	; 1.3670e-08	; 89.0	; ! C*298 = 0.1
VROCN2OXY8 <=> VROCN2OXY8	; 1.0;	1.	; 1.6386e-09	; 93.0	; ! C*298 = 0.01
