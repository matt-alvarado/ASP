O1D + H2O => 2 OH ; 2.14e-10; 0; -0; 1;
!! R12: <R12> O3 + OH = HO2 # 1.70E-12@940;
O3 + OH => HO2 ; 1.7e-12; 0; -940; 1;
!! R13: <R13> O3 + HO2 = OH # 2.03E-16^4.57@-693;
O3 + HO2 => OH ; 9.706259628e-28; 4.57; 693; 1;
