!! R7: <R7> O + O3 = # 8.00E-12@2060;
O + O3 => M ; 8e-12; 0; -2060; 1;
!! R8: <R8> O3 = O # 1.0/<O3_O3P_IUPAC10>;
O3 => O ; 0; 2;
!! R9: <R9> O3 = O1D # 1.0/<O3_O1D_IUPAC10>;
O3 => O1D ; 0; 3;
!! R10: <R10> O1D + M = O + M # 2.23E-11@-115;
!!   APPROXIMATION: ASP hard-wires O1D + M (flag 8, IUPAC N2/O2 form) instead of CB6r5 2.23e-11 exp(115/T)
O1D => O + M ; 8;
