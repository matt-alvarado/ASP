!! GasChemicalMechanism.in - CRACMM3, Williams case
!! ASP
!! Translated from the CMAQ mechanism definition mech_cracmm3.def by CB6r5Translation/mech2asp.py
!! (see CB6r5Translation/NewMechanisms_README.md for every choice and warning).
!! Gas-phase core only; CMAQ chlorine, heterogeneous, aerosol/SVOC, POA-aging, oligomerisation and toxics groups are not
!! translated.  465 CMAQ statements -> 441 ASP reactions.
!! REQUIRES common_asp >= 40c1760 (1-body rate flag 13, 3-body flag 4), which also contains the earlier flag fixes
!! (2-body flag 5 = 508ba8d, 3-body flag 2 = f3f1107).
!! Rate-flag conventions: see the header of the baseline decks; new flags:
!!   1-body flag 13:  k = kf / Keq,  kf = fall-off with explicit Troe N
!!       13; A0; n0; E0; Ai; ni; Ei; F; N; KeqA; KeqE;   k0 = A0 (T/300)^-n0 exp(E0/T) [M],  ki likewise,  Keq = KeqA exp(KeqE/T)
!!   3-body flag 4:   same fall-off form, no Keq:  4; A0; n0; E0; Ai; ni; Ei; F; N;
!!   2-body flag 11:  k = A exp(B/T) (C/T + D P[Pa] + F)/100  (CRACMM NO + HO2 -> HNO3, exact)
!! Case conditions: T = 288.4 K, P = 880.0 mb, PhotoRates.in from the Williams TUV table.
!!
!! Format: "!! <label>: <CMAQ statement>" precedes each translated reaction.

!! R001: <R001> O3 = O3P # 1.0/<O3O3P_NASA06>;
O3 => O ; 0; 1;
!! R002: <R002> O3 = O1D # 1.0/<O3O1D_NASA06>;
O3 => O1D ; 0; 2;
!! R003: <R003> H2O2 = 2.000*HO # 1.0/<H2O2_RACM2>;
H2O2 => 2 OH ; 0; 3;
!! R004: <R004> NO2 = O3P + NO # 1.0/<NO2_RACM2>;
NO2 => O + NO ; 0; 4;
!! R005: <R005> NO3 = NO # 1.0/<NO3NO_RACM2>;
NO3 => NO ; 0; 5;
!! R006: <R006> NO3 = O3P + NO2 # 1.0/<NO3NO2_RACM2>;
NO3 => O + NO2 ; 0; 6;
!! R007: <R007> HONO = HO + NO # 1.0/<HONO_RACM2>;
HONO => OH + NO ; 0; 7;
!! R008: <R008> HNO3 = HO + NO2 # 1.0/<HNO3_RACM2>;
HNO3 => OH + NO2 ; 0; 8;
!! R009: <R009> HNO4 = 0.200*HO + 0.800*HO2 + 0.800*NO2 + 0.200*NO3 # 1.0/<HNO4_RACM2>;
HNO4 => 0.2 OH + 0.8 HO2 + 0.8 NO2 + 0.2 NO3 ; 0; 9;
!! R010: <R010> HCHO = CO # 1.0/<HCHO_MOL_JPL19>;
HCHO => CO ; 0; 10;
!! R011: <R011> HCHO = 2.000*HO2 + CO # 1.0/<HCHO_RAD_JPL19>;
HCHO => 2 HO2 + CO ; 0; 11;
!! R012: <R012> ACD = HO2 + MO2 + CO # 1.0/<CH3CHO_RACM2>;
ACD => HO2 + MO2 + CO ; 0; 12;
!! R013: <R013> ALD = HO2 + ETHP + CO # 1.0/<ALD_JPL19>;
ALD => HO2 + ETHP + CO ; 0; 13;
!! R014: <R014> ACT = MO2 + ACO3 # 1.0/<CH3COCH3A_JPL19>;
ACT => MO2 + ACO3 ; 0; 14;
!! R014a: <R014a> ACT = 2.000*MO2 + CO # 1.0/<CH3COCH3B_JPL19>;
ACT => 2 MO2 + CO ; 0; 15;
!! R015: <R015> UALD = 1.220*HO2 + 0.784*ACO3 + 1.220*CO + 0.350*HCHO + 0.434*ALD + 0.216*KET - 0.5200*DELTA_C # 1.0/<UALD_RACM2>;
UALD => 1.22 HO2 + 0.784 ACO3 + 1.22 CO + 0.35 HCHO + 0.434 ALD + 0.216 KET ; 0; 16;
!! TRP01: <TRP01> PINAL = HO2 + PINALP + CO - 1.0000*DELTA_C # 1.0/<ALD_JPL19>;
PINAL => HO2 + PINALP + CO ; 0; 13;
!! TRP02: <TRP02> LIMAL = HO2 + LIMALP + CO - 1.0000*DELTA_C # 1.0/<ALD_JPL19>;
LIMAL => HO2 + LIMALP + CO ; 0; 13;
!! R016: <R016> MEK = 0.100*MO2 + ETHP + 0.900*ACO3 + 0.100*CO # 1.0/<MEK_JGR19>;
MEK => 0.1 MO2 + ETHP + 0.9 ACO3 + 0.1 CO ; 0; 17;
!! R017: <R017> KET = 1.500*ETHP + 0.500*ACO3 + 0.500*CO + 0.5000*DELTA_C # 1.0/<KET_JGR19>;
KET => 1.5 ETHP + 0.5 ACO3 + 0.5 CO ; 0; 18;
!! R018: <R018> HKET = HO2 + ACO3 + HCHO # 1.0/<HKET_RACM2>;
HKET => HO2 + ACO3 + HCHO ; 0; 19;
!! R019: <R019> MACR = 0.340*HO + 0.660*HO2 + 0.670*ACO3 + 0.330*MACP + 0.340*XO2 + 0.670*CO + 0.670*HCHO # 1.0/<MACR_RACM2>;
MACR => 0.34 OH + 0.66 HO2 + 0.67 ACO3 + 0.33 MACP + 0.34 XO2 + 0.67 CO + 0.67 HCHO ; 0; 20;
!! R020: <R020> MVK = 0.300*MO2 + 0.300*MACP + 0.700*CO + 0.700*UALD - 1.7000*DELTA_C # 1.0/<MVK_JPL19>;
MVK => 0.3 MO2 + 0.3 MACP + 0.7 CO + 0.7 UALD ; 0; 21;
!! R021: <R021> GLY = 2.000*CO # 1.0/<GLYH2_JPL19>;
GLY => 2 CO ; 0; 22;
!! R022: <R022> GLY = HCHO + CO # 1.0/<GLYF_JPL19>;
GLY => HCHO + CO ; 0; 23;
!! R023: <R023> GLY = 2.000*HO2 + 2.000*CO # 1.0/<GLYHX_JPL19>;
GLY => 2 HO2 + 2 CO ; 0; 24;
!! R024: <R024> MGLY = HO2 + ACO3 + CO # 1.0/<MGLY_RACM2>;
MGLY => HO2 + ACO3 + CO ; 0; 25;
!! R025: <R025> DCB1 = 1.500*HO2 + 0.250*ACO3 + 0.200*XO2 + CO + 0.500*GLY + 0.500*MGLY + 1.0000*DELTA_C # 1.0/<MGLY_RACM2>;
DCB1 => 1.5 HO2 + 0.25 ACO3 + 0.2 XO2 + CO + 0.5 GLY + 0.5 MGLY ; 0; 25;
!! R026: <R026> DCB2 = 1.500*HO2 + 0.250*ACO3 + 0.200*XO2 + CO + 0.500*GLY + 0.500*MGLY + 2.0000*DELTA_C # 1.0/<MGLY_RACM2>;
DCB2 => 1.5 HO2 + 0.25 ACO3 + 0.2 XO2 + CO + 0.5 GLY + 0.5 MGLY ; 0; 25;
!! R027a: <R027a> BALD = BEN + CO # 1.0/<BALD1_CALVERT11>;
BALD => BEN + CO ; 0; 26;
!! R027b: <R027b> BALD = BAL1 + CO + HO2 # 1.0/<BALD2_CALVERT11>;
BALD => BAL1 + CO + HO2 ; 0; 27;
!! R028: <R028> OP1 = HO + HO2 + HCHO # 1.0/<OP1_RACM2>;
OP1 => OH + HO2 + HCHO ; 0; 28;
!! R029: <R029> OP2 = HO + HO2 + ALD - 1.0000*DELTA_C # 1.0/<OP1_RACM2>;
OP2 => OH + HO2 + ALD ; 0; 28;
!! TRP03: <TRP03> OPB = HO + HO2 + ALD + 7.0000*DELTA_C # 1.0/<OP1_RACM2>;
OPB => OH + HO2 + ALD ; 0; 28;
!! R030: <R030> PAA = HO + MO2 + 1.0000*DELTA_C # 1.0/<PAA_RACM2>;
PAA => OH + MO2 ; 0; 29;
!! R031: <R031> ONIT = HO2 + NO2 + 0.200*ALD + 0.800*KET - 0.6000*DELTA_C # 1.0/<ONIT_CALVERT08>;
ONIT => HO2 + NO2 + 0.2 ALD + 0.8 KET ; 0; 30;
!! R032: <R032> PAN = ACO3 + NO2 # 1.0/<PAN1_JPL19>;
PAN => ACO3 + NO2 ; 0; 31;
!! R033: <R033> PAN = MO2 + NO3 + CO2 # 1.0/<PAN2_JPL19>;
PAN => MO2 + NO3 + CO2 ; 0; 32;
!! R033a: <R033a> PPN = RCO3 + NO2 # 1.0/<PPN1_JPL19>;
PPN => RCO3 + NO2 ; 0; 33;
!! R033b: <R033b> PPN = HC3P + NO3 # 1.0/<PPN2_JPL19>;
PPN => HC3P + NO3 ; 0; 34;
!! R034: <R034> O3 + HO = HO2 # 1.7E-12 @ 940.;
O3 + OH => HO2 ; 1.7e-12; 0; -940; 1;
!! R035: <R035> O3 + HO2 = HO # 1.0E-14 @ 490.;
O3 + HO2 => OH ; 1e-14; 0; -490; 1;
!! R036: <R036> O3 + NO = NO2 # 3.0E-12 @ 1500.;
O3 + NO => NO2 ; 3e-12; 0; -1500; 1;
!! R037: <R037> O3 + NO2 = NO3 # 1.2E-13 @ 2450.;
O3 + NO2 => NO3 ; 1.2e-13; 0; -2450; 1;
!! R038: <R038> O3P + O2 + M = O3 # 6.10E-34 ^ -2.4;
!!   APPROXIMATION: ASP hard-wires O + O2 + M (flag 9): 5.6e-34 N2 / 6.0e-34 O2 (T/300)^-2.6 instead of the CMAQ coefficient; O(3P) is >99%% converted to O3 either way
O => O3 ; 9;
!! R039: <R039> O3P + O3 = # 8.0E-12 @ 2060.;
O + O3 => M ; 8e-12; 0; -2060; 1;
!! R040: <R040> O1D + O2 = O3P # 3.3E-11 @ -55.;
!!   APPROXIMATION: ASP hard-wires O1D quenching by air (flag 8, IUPAC N2/O2 form, one reaction); CMAQ has separate O1D + O2 and O1D + N2 reactions (agrees within ~1%)
O1D => O ; 8;
!! R042: <R042> O1D + H2O = 2.000*HO # 1.63E-10 @ -60.0;
O1D + H2O => 2 OH ; 1.63e-10; 0; 60; 1;
!! R043: <R043> HO + H2 = HO2 # 2.80E-12 @ 1800.;
OH + H2 => HO2 ; 2.8e-12; 0; -1800; 1;
!! R044: <R044> HO + HO2 = # 4.8E-11 @ -250.;
OH + HO2 => M ; 4.8e-11; 0; 250; 1;
!! R045: <R045> HO2 + HO2 = H2O2 %3 # 3.0E-13 @ -460. & 2.1E-33 @ -920.;
HO2 + HO2 => H2O2 ; 4; 3e-13; 460; 2.1e-33; 920;
!! R046: <R046> HO2 + HO2 + H2O = H2O2 %3 # 4.20E-34 @ -2660. & 2.94E-54 @ -3120.;
HO2 + HO2 => H2O2 ; 10; 4.2e-34; 2660; 2.94e-54; 3120;
!! R047: <R047> H2O2 + HO = HO2 # 1.8E-12 @ 0.;
H2O2 + OH => HO2 ; 1.8e-12; 0; -0; 1;
!! R048: <R048> NO + O3P = NO2 # 9.1E-32 ^ -1.5 & 3.0E-11 ^ 0.0 ;
NO + O + M => NO2 + M ; 9.1e-32; 1.5; 3e-11; -0; 0.6;
!! R049: <R049> NO + HO = HONO # 7.1E-31 ^ -2.6 & 3.6E-11 ^ -0.1;
NO + OH + M => HONO + M ; 7.1e-31; 2.6; 3.6e-11; 0.1; 0.6;
!! R050: <R050> NO + HO2 = NO2 + HO # 3.44E-12 @ -260.;
NO + HO2 => NO2 + OH ; 3.44e-12; 0; 260; 1;
!! R051: <R051> NO + HO2 = HNO3 %3 # 6.095e-14^-1.0@-270.0 & 6.857e-34^1.0@-270.0& -5.968e-14@-270.0;
!!   NOTE: CMAQ FALLOFF_T11 (k1 (T/300)^-1 + k2 (T/300) M + k3) exp(270/T) rewritten exactly as ASP 2-body flag 11 [T and P dependence of M cancels analytically]
NO + HO2 => HNO3 ; 11; 1; 270; 1.8285e-09; 1.655501628e-17; -5.968e-12;
!! R052: <R052> NO + NO + O2 = 2.000*NO2 # 4.25E-39 @ -663.5;
!!   NOTE: termolecular NO+NO+O2: 3-body rate flag 2 with [O2] = 0.2095 [M] (needs the common_asp flag-2 fix)
NO + NO + M => 2 NO2 + M ; 2; 8.90375e-40; 0; 663.5; 1;
!! R053: <R053> HONO + HO = NO2 # 3.0E-12 @ -250.;
HONO + OH => NO2 ; 3e-12; 0; 250; 1;
!! R054: <R054> NO2 + O3P = NO # 5.3E-12 @ -200.;
NO2 + O => NO ; 5.3e-12; 0; 200; 1;
!! R055: <R055> NO2 + O3P = NO3 # 3.4E-31 ^ -1.6 & 2.3E-11 ^ -0.2;
NO2 + O + M => NO3 + M ; 3.4e-31; 1.6; 2.3e-11; 0.2; 0.6;
!! R056: <R056> NO2 + HO = HNO3 # 1.80E-30 ^ -3.0 & 2.80E-11 ^ 0.0;
NO2 + OH + M => HNO3 + M ; 1.8e-30; 3; 2.8e-11; -0; 0.6;
!! R057: <R057> HNO3 + HO = NO3 %2 # 2.4E-14 @ -460 & 2.7E-17 @ -2199 & 6.5E-34 @ -1335;
!!   NOTE: CMAQ %2 form k0 + k3[M]/(1+k3[M]/k2) = ASP 2-body flag 5 (needs common_asp >= 508ba8d)
HNO3 + OH => NO3 ; 5; 2.4e-14; 460; 2.7e-17; 2199; 6.5e-34; 1335;
!! R058: <R058> NO3 + HO = HO2 + NO2 # 2.0E-11;
NO3 + OH => HO2 + NO2 ; 2e-11; 0; -0; 1;
!! R059: <R059> NO3 + HO2 = 0.700*HO + 0.700*NO2 + 0.300*HNO3 # 3.50E-12;
NO3 + HO2 => 0.7 OH + 0.7 NO2 + 0.3 HNO3 ; 3.5e-12; 0; -0; 1;
!! R060: <R060> NO3 + NO = 2.000*NO2 # 1.7E-11 @ -125.;
NO3 + NO => 2 NO2 ; 1.7e-11; 0; 125; 1;
!! R061: <R061> NO3 + NO2 = NO + NO2 # 4.35E-14 @ 1335.;
NO3 + NO2 => NO + NO2 ; 4.35e-14; 0; -1335; 1;
!! R062: <R062> NO3 + NO3 = 2.000*NO2 # 8.5E-13 @ 2450.;
NO3 + NO3 => 2 NO2 ; 8.5e-13; 0; -2450; 1;
!! R063: <R063> NO3 + NO2 = N2O5 # 2.40E-30 ^ -3.0 & 1.6E-12 ^ +0.1;
NO3 + NO2 + M => N2O5 + M ; 2.4e-30; 3; 1.6e-12; -0.1; 0.6;
!! R064: <R064> N2O5 = NO2 + NO3 # 5.80E-27 @ -10840.0 *E<R063>;
!!   NOTE: reverse reaction via the equilibrium constant of R063: ASP 1-body flag 13 (fall-off / Keq)
N2O5 => NO2 + NO3 ; 13; 2.4e-30; 3; -0; 1.6e-12; -0.1; -0; 0.6; 1; 5.8e-27; 10840;
!! R065: <R065> N2O5 + H2O = 2.000*HNO3 # 1.0E-22;
N2O5 + H2O => 2 HNO3 ; 1e-22; 0; -0; 1;
!! R066: <R066> NO2 + HO2 = HNO4 # 1.9E-31 ^ -3.4 & 4.0E-12 ^ -0.3;
NO2 + HO2 + M => HNO4 + M ; 1.9e-31; 3.4; 4e-12; 0.3; 0.6;
!! R067: <R067> HNO4 = HO2 + NO2 # 2.10E-27 @ -10900.0 *E<R066>;
!!   NOTE: reverse reaction via the equilibrium constant of R066: ASP 1-body flag 13 (fall-off / Keq)
HNO4 => HO2 + NO2 ; 13; 1.9e-31; 3.4; -0; 4e-12; 0.3; -0; 0.6; 1; 2.1e-27; 10900;
!! R068: <R068> HNO4 + HO = NO2 # 4.50E-13 @ -610.;
HNO4 + OH => NO2 ; 4.5e-13; 0; 610; 1;
!! R069: <R069> SO2 + HO = HO2 + SULF + SULRXN # 2.9E-31 ^ -4.1 & 1.7E-12 ^ +0.2;
!!   NOTE: CMAQ SOA/SVOC bookkeeping products not carried: SULRXN
SO2 + OH + M => HO2 + H2SO4 + M ; 2.9e-31; 4.1; 1.7e-12; -0.2; 0.6;
!! R070: <R070> CO + HO = HO2 + CO2 %3 # 1.44E-13 @ 0.0 & 2.74E-33 @ 0.0;
CO + OH => HO2 + CO2 ; 4; 1.44e-13; -0; 2.74e-33; -0;
!! R071: <R071> HO + CH4 = MO2 - 1.0000*DELTA_C # 2.45E-12 @ 1775.;
OH + CH4 => MO2 ; 2.45e-12; 0; -1775; 1;
!! R072: <R072> ETH + HO = ETHP # 7.66E-12 @ 1020.;
ETH + OH => ETHP ; 7.66e-12; 0; -1020; 1;
!! R073: <R073> HC3 + HO = HC3P + 0.0000281*ASOATJ - 0.0001*DELTA_C # 7.68E-12 @ 370.;
!!   NOTE: CMAQ SOA/SVOC bookkeeping products not carried: ASOATJ
HC3 + OH => HC3P ; 7.68e-12; 0; -370; 1;
!! R074: <R074> HC5 + HO = HC5P + 0.00134*ASOATJ - 0.0093*DELTA_C # 1.01E-11 @ 245.;
!!   NOTE: CMAQ SOA/SVOC bookkeeping products not carried: ASOATJ
!!   NOTE: ASP SOA counter HC5SOA attached to HC5 + OH (as in the baseline mechanism)
HC5 + OH => HC5P + HC5SOA ; 1.01e-11; 0; -245; 1;
!! R076: <R076> ETE + HO = ETEP # 1.0E-28 ^ -4.5 & 8.8E-12 ^ -0.85;
ETE + OH + M => ETEP + M ; 1e-28; 4.5; 8.8e-12; 0.85; 0.6;
!! R077: <R077> OLT + HO = OLTP # 5.72E-12 @ -500.;
!!   NOTE: ASP SOA counter OLTSOA attached to OLT + OH (as in the baseline mechanism)
OLT + OH => OLTP + OLTSOA ; 5.72e-12; 0; 500; 1;
!! R078: <R078> OLI + HO = OLIP # 1.33E-11 @ -500.;
!!   NOTE: ASP SOA counter OLISOA attached to OLI + OH (as in the baseline mechanism)
OLI + OH => OLIP + OLISOA ; 1.33e-11; 0; 500; 1;
!! R080: <R080> ACE + HO = 0.650*HO + 0.350*HO2 + 0.350*CO + 0.650*GLY + 0.350*ORA1 # 5.5E-30 ^ 0.0 & 8.3E-13 ^ 2.0;
ACE + OH + M => 0.65 OH + 0.35 HO2 + 0.35 CO + 0.65 GLY + 0.35 ORA1 + M ; 5.5e-30; -0; 8.3e-13; -2; 0.6;
!! ROCARO31: <ROCARO31> BEN + HO = 0.470*BENP + 0.530*PHEN + 0.530*HO2 # 2.33E-12 @ 193.;
BEN + OH => 0.47 BENP + 0.53 PHEN + 0.53 HO2 ; 2.33e-12; 0; -193; 1;
!! ROCARO41: <ROCARO41> TOL + HO = 0.820*TOLP + 0.180*CSL + 0.180*HO2 # 1.81E-12 @ -354.;
!!   NOTE: ASP SOA counter TOLSOA attached to TOL + OH (as in the baseline mechanism)
TOL + OH => 0.82 TOLP + 0.18 CSL + 0.18 HO2 + TOLSOA ; 1.81e-12; 0; 354; 1;
!! ROCARO51: <ROCARO51> XYL + HO = 0.830*XYLP + 0.170*CSL + 0.170*HO2 + 0.1700*DELTA_C # 2.33E-11;
!!   NOTE: ASP SOA counter XYLSOA attached to XYL + OH (as in the baseline mechanism)
XYL + OH => 0.83 XYLP + 0.17 CSL + 0.17 HO2 + XYLSOA ; 2.33e-11; 0; -0; 1;
!! ROCARO61: <ROCARO61> EBZ + HO = 0.820*EBZP + 0.180*CSL + 0.180*HO2 + 0.1800*DELTA_C # 7.00E-12;
EBZ + OH => 0.82 EBZP + 0.18 CSL + 0.18 HO2 ; 7e-12; 0; -0; 1;
!! ROCARO61a: <ROCARO61a> EBZ + NO3 = EBZP + HNO3 # 5.70E-16;
EBZ + NO3 => EBZP + HNO3 ; 5.7e-16; 0; -0; 1;
!! RAM01: <RAM01> ISO + O3 = 0.250*HO + 0.250*HO2 + 0.400*MO2 + 0.018*ACO3 + 0.100*MACP + 0.090*H2O2 + 0.220*CO + HCHO + 0.300*MACR + 0.140*MVK + 0.280*ORA1 + 0.153*OLT + 0.4450*DELTA_C # 1.58E-14 @ 2000;
!!   NOTE: ASP SOA counter ISOSOA attached to ISO + O3 (as in the baseline mechanism)
ISO + O3 => 0.25 OH + 0.25 HO2 + 0.4 MO2 + 0.018 ACO3 + 0.1 MACP + 0.09 H2O2 + 0.22 CO + HCHO + 0.3 MACR + 0.14 MVK + 0.28 ORA1 + 0.153 OLT + ISOSOA ; 1.58e-14; 0; -2000; 1;
!! RAM02: <RAM02> ISO + NO3 = 0.400*NO2 + 0.045*ISON + 0.350*HCHO + 0.555*ISONP + 0.260*MVK + 0.028*MACR + 0.4980*DELTA_C # 2.95E-12 @ 450;
!!   NOTE: ASP SOA counter ISOSOA attached to ISO + NO3 (as in the baseline mechanism)
ISO + NO3 => 0.4 NO2 + 0.045 ISON + 0.35 HCHO + 0.555 ISONP + 0.26 MVK + 0.028 MACR + ISOSOA ; 2.95e-12; 0; -450; 1;
!! RAM03: <RAM03> ISO + HO = ISOP + 0.250*HCHO + 0.030*MACR + 0.050*MGLY - 0.5200*DELTA_C # 2.69E-11 @ -390;
!!   NOTE: ASP SOA counter ISOSOA attached to ISO + OH (as in the baseline mechanism)
ISO + OH => ISOP + 0.25 HCHO + 0.03 MACR + 0.05 MGLY + ISOSOA ; 2.69e-11; 0; 390; 1;
!! RAM04: <RAM04> ISOP + HO2 = ISHP + 0.070*HO2 + 0.500*HO # 4.5E-13 @ -1300;
ISOP + HO2 => ISHP + 0.07 HO2 + 0.5 OH ; 4.5e-13; 0; 1300; 1;
!! RAM05: <RAM05> ISOP + NO = 0.130*ISON + 0.400*HCHO + 0.880*HO2 + 0.870*NO2 + 0.180*MACR + 0.510*MVK + 1.1900*DELTA_C # 6E-12 @ -350;
ISOP + NO => 0.13 ISON + 0.4 HCHO + 0.88 HO2 + 0.87 NO2 + 0.18 MACR + 0.51 MVK ; 6e-12; 0; 350; 1;
!! RAM06: <RAM06> ISHP + HO = ISOP # 4.6E-12 @ -200;
ISHP + OH => ISOP ; 4.6e-12; 0; 200; 1;
!! RAM07: <RAM07> ISHP + HO = 0.040*MGLY + 0.020*GLY + 0.130*MVK + 0.440*IEPOX + 0.110*ACO3 + 0.030*MACR + 2.000*HO + 0.340*HO2 + 0.140*IPX + CO + 0.0800*DELTA_C # 2.97E-11 @ -390;
ISHP + OH => 0.04 MGLY + 0.02 GLY + 0.13 MVK + 0.44 IEPOX + 0.11 ACO3 + 0.03 MACR + 2 OH + 0.34 HO2 + 0.14 IPX + CO ; 2.97e-11; 0; 390; 1;
!! RAM08: <RAM08> ISONP + HO2 = 0.450*HO + 0.950*INALD + 0.020*IPX + 0.0500*DELTA_N + 0.1500*DELTA_C # 3.14E-11 @ -580;
